#!/bin/sh
# gdlcot.postinst from https://github.com/snstac/gdlcot
# Copyright Sensors & Signals LLC https://www.snstac.com/
# SPDX-License-Identifier: Apache-2.0
set -e

systemctl disable --now gdltak.service >/dev/null 2>&1 || true
if [ -f /etc/default/gdltak ]; then
  sed 's/GDLTAK/GDLCOT/g; s/gdltak/gdlcot/g' \
    /etc/default/gdltak > /etc/default/gdlcot
  chmod 0644 /etc/default/gdlcot
  mv /etc/default/gdltak /etc/default/gdltak.migrated
fi

SERVER_HOME=/run/gdlcot
SERVER_USER=gdlcot
SERVER_NAME="CoT to GDL90 Gateway System User"
SERVER_GROUP=gdlcot

# Create system group/user so the service does not run as root.
if ! getent group "$SERVER_GROUP" >/dev/null; then
  addgroup --quiet --system "$SERVER_GROUP" 2>/dev/null || true
fi
if ! getent passwd "$SERVER_USER" >/dev/null; then
  adduser --quiet \
          --system \
          --ingroup "$SERVER_GROUP" \
          --no-create-home \
          --disabled-password \
          --home "$SERVER_HOME" \
          --gecos "$SERVER_NAME" \
          "$SERVER_USER" 2>/dev/null || true
fi

if command -v systemctl >/dev/null 2>&1; then
  systemctl daemon-reload || true
fi

# gdlcot.service ships disabled; opt in with:
#   sudo systemctl enable --now gdlcot

exit 0
