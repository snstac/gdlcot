[Unit]
Description=GDLTAK: Display TAK air pictures in ForeFlight - CoT to GDL90 Gateway.
Documentation=https://github.com/snstac/gdltak
Wants=network-online.target
After=network-online.target

[Service]
Type=simple
User=gdltak
EnvironmentFile=-/etc/aryaos/aryaos-config.txt
EnvironmentFile=-/etc/default/gdltak
ExecStart=/usr/bin/gdltak
RuntimeDirectory=gdltak
SyslogIdentifier=gdltak
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
